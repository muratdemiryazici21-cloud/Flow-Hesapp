rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Catch-All Safety Net: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function isValidUsername(username) {
      return username is string && username.size() >= 3 && username.size() <= 30 && username.matches('^[a-zA-Z0-9._-]+$');
    }

    // Validation for UserProfile
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'username', 'email', 'createdAt'])
        && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 100
        && isValidUsername(data.username)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 150
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 200000))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 250))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50))
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Validation for UserSession
    function isValidSession(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'deviceName', 'deviceType', 'createdAt'])
        && data.userId == userId
        && data.id is string && data.id.size() <= 128
        && data.deviceName is string && data.deviceName.size() <= 100
        && data.deviceType is string && data.deviceType.size() <= 50;
    }

    // Validation for ConnectedDevice
    function isValidConnectedDevice(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'deviceName', 'status', 'linkedAt'])
        && data.userId == userId
        && data.id is string && data.id.size() <= 128
        && data.deviceName is string && data.deviceName.size() <= 100
        && (data.status == 'active' || data.status == 'revoked');
    }

    // Validation for AuthorizedApp
    function isValidAuthorizedApp(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'appName', 'authorizedAt', 'status'])
        && data.userId == userId
        && data.id is string && data.id.size() <= 128
        && data.appName is string && data.appName.size() <= 50
        && (data.status == 'active' || data.status == 'revoked');
    }

    // Validation for SecurityLog
    function isValidSecurityLog(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'action', 'type', 'timestamp', 'status'])
        && data.userId == userId
        && data.id is string && data.id.size() <= 128
        && data.action is string && data.action.size() <= 100;
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // PII protection: no blanket user listing
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);

      // Sessions subcollection
      match /sessions/{sessionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(sessionId) && isValidSession(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidSession(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      // Connected Devices subcollection
      match /connectedDevices/{deviceId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(deviceId) && isValidConnectedDevice(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidConnectedDevice(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      // Authorized OAuth Apps subcollection
      match /authorizedApps/{appId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(appId) && isValidAuthorizedApp(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidAuthorizedApp(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      // Security & Activity Audit Logs
      match /securityLogs/{logId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId) && isValidSecurityLog(request.resource.data, userId);
        allow update, delete: if isOwner(userId);
      }

      // User Settings (Privacy and 2FA Config)
      match /settings/{settingId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(settingId);
        allow delete: if isOwner(userId);
      }
    }

    // Username reservation registry (enforcing unique usernames)
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() 
                    && isValidUsername(username)
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.username == username;
      allow update: if isSignedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
